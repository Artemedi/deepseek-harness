# Copy to .env and replace every value locally. Never commit .env.
# TencentDB Memory Core and Proxy use independent LLM credentials.
MEMORY_LLM_BASE_URL=REPLACE_ME
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_LLM_PROTOCOL=openai

PROXY_UPSTREAM_URL=REPLACE_ME
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=REPLACE_ME

# Names are unique to this integration project.
TDAI_NETWORK=harness-tdai
TDAI_CORE_CONTAINER=harness-tdai-core
TDAI_HUB_CONTAINER=harness-tdai-hub
TDAI_PROXY_CONTAINER=harness-tdai-proxy
TDAI_CORE_VOLUME=harness-tdai-core-data
TDAI_HUB_VOLUME=harness-tdai-hub-data

TDAI_CORE_PORT=18420
TDAI_PANEL_PORT=18125
TDAI_KNOWLEDGE_PORT=18424
TDAI_PROXY_PORT=18096

# Pin digests for reproducible runs after reviewing the upstream release.
TDAI_CORE_IMAGE=agentmemory/memory-core@sha256:9798254a8cc06276b7c5b3c19df49f136fae25d579564e1f01f9c4b9b8cd2d11
TDAI_HUB_IMAGE=agentmemory/memory-hub@sha256:39548fd616f6f211ad2288e33fe5e93870b705cffe0468047520cd786408e657
TDAI_PROXY_IMAGE=agentmemory/memory-proxy@sha256:c8de30142787a5df7937c02c167f2ee37f00505b79036357653a6ce78a29fba5

# Opt-in native TencentDB Agent Memory retrieval for an existing DSH profile.
# The loopback standalone Gateway does not require a bearer credential.
# For a protected or non-loopback Gateway, configure credentialRef and set the
# same secret as its TDAI_GATEWAY_API_KEY through DSH credentials.
- insert:
    - id: tencentdb-memory-service
      name: '@deepseek-ai/dsh-experimental-memory'
      config:
        providers: [local, tencentdb]
        automaticCapture: true
        automaticRecall: true
        tencentdb:
          baseUrl: http://127.0.0.1:8420
          # credentialRef: TDAI_MEMORY_API_KEY
          serviceId: default
          teamId: default
          agentId: default
          userId: default
    - id: tencentdb-memory-tool
      name: '@deepseek-ai/dsh-experimental-tool-memory'
